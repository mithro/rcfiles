# ── Plugins (loaded LAST via linkit postfix) ──────────────────────────
# setup.sh linkit() appends this file AFTER the base config and all
# host-specific parts, so the run-shell loader below runs last and
# continuum wraps the FINAL status-right (incl. host overrides) with its
# autosave hook. continuum prepends #(continuum_save.sh) to status-right
# ONCE at load; if a host status-right set ran after the loader it would
# silently drop autosave -- hence loading here, last. See docs spec section 4.
#
# TPM is vendored as a git submodule at ~/rcfiles/tmux/plugins/tpm
# (pinned; updated via git, not prefix+U). Managed plugins clone OUTSIDE
# the repo into ~/.tmux/plugins/.
#   prefix+I install   prefix+U update
#   prefix+M-s save (resurrect)   prefix+M-r restore
set -g @plugin 'tmux-plugins/tmux-resurrect'
set -g @plugin 'tmux-plugins/tmux-continuum'

# Auto-restore the `last` save when the tmux server starts fresh (host
# reboot / server restart). continuum.tmux reads this at load, so it must
# be set before the run-shell loader below. Restore was previously
# deliberately manual-only; flipped 2026-08-20 after ten64 rebooted and
# came back with empty sessions. The degenerate-save guard
# (resurrect-post-save) and continuum-attach-grace keep `last` trustworthy
# enough to replay unattended; desktop.buddy has run with auto-restore on
# since its next-3.8 adoption (2026-07-27) without incident. Manual
# prefix+M-r restore still works as a fallback.
set -g @continuum-restore 'on'

# Remap resurrect's save/restore off the default prefix+Ctrl-s / prefix+Ctrl-r.
# Ctrl-s sits right next to the prefix+s session picker: with Ctrl still held
# from the C-a prefix chord, an intended `C-a s` becomes `C-a C-s` and fires an
# accidental save. M-s / M-r use Alt (not the held Ctrl), so the slip can't
# happen.
set -g @resurrect-save 'M-s'
set -g @resurrect-restore 'M-r'

# Save pane scrollback contents...
set -g @resurrect-capture-pane-contents 'on'
# ...and relaunch these on restore, plus resurrect's conservative
# defaults (vi vim nvim emacs man less more tail top htop).
#   claude         — a Claude pane the hook below could not rewrite (falls back
#                    to the resume picker).
#   ~claude-resume — the rewritten `~/bin/claude-resume <id>` command; the ~
#                    makes resurrect substring-match it (it starts with an
#                    absolute path, so a plain `claude` entry would never hit).
set -g @resurrect-processes 'ssh mosh-client claude ~claude-resume'

# Post-save dispatcher (~/bin/resurrect-post-save), run after each save while
# the old `last` is still in place: (1) logs every save with context to
# <resurrect-dir>/save-events.log; (2) GUARDS against a degenerate clobber --
# if the new save collapsed to far fewer panes than `last` (e.g. a reattach
# autosave of an emptied session), it overwrites the new file with `last`'s
# bytes so resurrect's cmp dedup discards it and `last` survives; (3) otherwise
# chains ~/bin/claude-resume-save-hook to rewrite each Claude pane's restore
# command to carry its real session id (~/bin/claude-resume <id>), so picker-
# launched / bare `claude` panes restore to the right session.
set -g @resurrect-hook-post-save-layout '~/bin/resurrect-post-save'

set -g @continuum-save-interval '15'

# Reattach grace. continuum's autosave timer (@continuum-save-last-timestamp)
# only advances while a client is attached and FREEZES while detached, so the
# first status tick after a detach longer than the interval saves IMMEDIATELY
# (the gate now >= last+interval is already satisfied) -- clobbering `last` with
# the on-screen, possibly degenerate, state before you can prefix+Ctrl-r. Push
# the timer forward on attach (only when already stale, so the normal cadence is
# untouched) to grant a fresh interval to restore. -ga appends, never replacing
# an existing client-attached hook. See ~/bin/continuum-attach-grace.
set-hook -ga client-attached 'run-shell ~/bin/continuum-attach-grace'

set-environment -g TMUX_PLUGIN_MANAGER_PATH '~/.tmux/plugins/'

# Guard so a host without the submodule still gets a working plain tmux.
if-shell "test -x ~/rcfiles/tmux/plugins/tpm/tpm" \
    "run-shell ~/rcfiles/tmux/plugins/tpm/tpm"
