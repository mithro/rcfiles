# tmux(1) completion, local additions                      -*- shell-script -*-
#
# The real work is done by bash-completion's own tmux completion, which asks
# the running tmux for its commands and flags (so it is always current). It is
# loaded from the system if bash-completion ships it (>= 2.17), otherwise from
# the vendored copy in upstream/tmux (refreshed by ./update-tmux).
#
# Upstream completes every command and flag but only a few argument *values*
# (its _comp_cmd_tmux__value carries a "TODO: Complete more option types").
# This file fills those in — windows, panes, clients, buffers, key tables,
# option and hook names, layouts, sockets — by wrapping that one function, so
# the vendored file stays byte-identical to upstream.

# (This file is reached through a symlink, hence the realpath.)
for _rc_tmux_f in /usr/share/bash-completion/completions/tmux \
    "$(dirname "$(realpath "${BASH_SOURCE[0]}")")/upstream/tmux"; do
    if [[ -r $_rc_tmux_f ]]; then
        # shellcheck source=/dev/null
        source "$_rc_tmux_f"
        break
    fi
done
unset _rc_tmux_f

# Upstream needs the bash-completion >= 2.12 API. Test for that API, not for
# upstream's functions: the vendored file defines those on any version, and
# would then print "command not found" on every <TAB>.
declare -F _comp_initialize >/dev/null &&
    declare -F _comp_cmd_tmux__value >/dev/null || return 0

# Offer the lines printed by `tmux "$@"` that match the word being completed.
#
# Names are user-chosen (`my session`) and bash inserts a candidate verbatim,
# so each is offered shell-escaped. The matching is done here rather than by
# compgen so that it compares like with like: the name as tmux prints it
# against the half-typed word with its quoting removed.
_rc_tmux__lines()
{
    local line quoted word=$cur
    local -a REPLY
    if _comp_dequote "$cur"; then
        word=${REPLY[0]-}
    fi
    while IFS= read -r line; do
        if [[ $line == "$word"* ]]; then
            printf -v quoted '%q' "$line"
            COMPREPLY+=("$quoted")
        fi
    done < <(_comp_cmd_tmux__run "$@" 2>/dev/null)
}

# Complete the value types upstream leaves out.
#
# @param $1 subcommand the value is for, or 'tmux' if it's top-level
# @param $2 type of the value, as named in tmux's own usage text
# @return 1 if the type is not handled here (upstream gets its turn)
_rc_tmux__value()
{
    case $2 in
        target-window | src-window | dst-window | source-window)
            _rc_tmux__lines list-windows -a -F '#{session_name}:#{window_index}'
            ;;
        target-pane | src-pane | dst-pane | pane)
            _rc_tmux__lines list-panes -a \
                -F '#{session_name}:#{window_index}.#{pane_index}'
            ;;
        target-client)
            _rc_tmux__lines list-clients -F '#{client_name}'
            ;;
        buffer-name | new-buffer-name)
            _rc_tmux__lines list-buffers -F '#{buffer_name}'
            ;;
        key-table)
            # Parsed from the plain listing (`bind-key [-r] -T table key ...`):
            # `list-keys -F` would be neater but tmux only gained it in 3.5.
            _comp_compgen_split -l -- "$(_comp_cmd_tmux__run list-keys \
                2>/dev/null |
                sed -n -e 's/^bind-key[^T]*-T  *\([^ ]*\).*/\1/p' | sort -u)"
            ;;
        option)
            # Server, session and window options (user @options included);
            # array options print as name[N], so cut the index off too.
            _comp_compgen_split -l -- "$({
                _comp_cmd_tmux__run show-options -s
                _comp_cmd_tmux__run show-options -g
                _comp_cmd_tmux__run show-options -gw
            } 2>/dev/null | sed -e 's/[[ ].*//' | sort -u)"
            ;;
        hook)
            _comp_compgen_split -l -- "$(_comp_cmd_tmux__run show-hooks -g \
                2>/dev/null | sed -e 's/[[ ].*//' | sort -u)"
            ;;
        layout-name)
            _comp_compgen -- -W 'even-horizontal even-vertical main-horizontal
                main-horizontal-mirrored main-vertical main-vertical-mirrored
                tiled'
            ;;
        socket-name)
            _comp_compgen_split -l -- "$(command ls \
                "${TMUX_TMPDIR:-/tmp}/tmux-$UID" 2>/dev/null)"
            ;;
        *)
            return 1
            ;;
    esac
}

# Keep upstream's function under another name and put ours in front of it.
eval "_rc_tmux__upstream_value() $(declare -f _comp_cmd_tmux__value | tail -n +2)"
_comp_cmd_tmux__value()
{
    _rc_tmux__value "$@" || _rc_tmux__upstream_value "$@"
}

# Targets look like `session:window.pane`, but readline splits words at ':' and
# upstream then sees three words where tmux sees one. Hand upstream the line
# re-split with ':' kept inside words, then trim what readline will not replace.
_rc_tmux()
{
    local cur words cword
    _comp_get_words -n : cur words cword
    local COMP_WORDS=("${words[@]}") COMP_CWORD=$cword
    local _rc_tmux_cur=$cur
    _comp_cmd_tmux "$@"
    _comp_ltrim_colon_completions "$_rc_tmux_cur"
} &&
    complete -F _rc_tmux tmux
